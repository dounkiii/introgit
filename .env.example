# =============================================================================
# 環境変数サンプル
#   このファイルを .env にコピーして値を設定してください:
#     cp .env.example .env
#   .env は .gitignore 済みなので、APIキーはコミットされません。
# =============================================================================

# --- AI分析プロバイダの選択（省略時は config/settings.yaml の analyzer.provider を使用） ---
# heuristic | openai | gemini | anthropic
# ANALYZER_PROVIDER=heuristic

# --- 各社 API キー（使うプロバイダのものだけ設定すればOK。全て未設定でも heuristic で動作） ---
# OpenAI:    https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- 任意: X(Twitter) API v2 のBearerトークン ---
#   tools/fetch_x_post.py が X Articles の本文取得を試みる際に使用します。
#   未設定でも埋め込みAPI経路で通常の投稿は読めます（記事本文は冒頭のみ）。
#   取得先: https://console.x.com （アプリ作成 → Keys and tokens → Bearer Token）
#   課金: 従量課金。Post read 1件 $0.005（同一リソースは24時間UTC内で重複課金なし）
X_BEARER_TOKEN=

# --- 任意: Reddit などへ渡す連絡先（User-Agent 用。無くても動作） ---
# CONTACT_EMAIL=you@example.com
